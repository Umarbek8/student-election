# Copy this file to .env.local and fill in values from your Firebase project
# (Firebase console > Project settings > General > Your apps > SDK setup).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Master password for the "School Leadership / Principal" sign-in on the
# landing screen. Change this before you hand out the shared classroom
# devices -- never leave the sample value in place for a real election.
VITE_ADMIN_PASSWORD=najwaubek28:22
